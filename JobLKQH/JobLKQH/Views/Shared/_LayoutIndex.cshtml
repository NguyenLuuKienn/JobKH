<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobZilla</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JobLKQH.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/work.css" asp-append-version="true" />
</head>
<body>
    
        <nav class="navjob">
            <div class="logo">
                <a asp-controller="Home" asp-action="Index">
                    <h1>JobZilla</h1>
                </a>
            </div>            
            <ul class="left-menu">
                <li>
                    <a class="find-job" asp-controller="Work" asp-action="WorkPage">
                        Tìm việc
                    </a>
                </li>
            </ul>
            <ul class="right-menu">                
                <a class="btn-link" asp-area="" asp-controller="Account" asp-action="Login">
                <li><button class="btn-auth">Đăng nhập</button></li>
                </a>
                <a class="btn-link" asp-area="" asp-controller="Account" asp-action="Register">
                <li><button class="btn-auth">Đăng ký</button></li>
                </a>
            </ul>
        </nav>
    
    <div class="">
        <main role="main" class="">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="footer-content">
           <div class="table-footer">
               <div class="right-table-footer">
                   <div class="header-right-table-footer">
                       <span class="footer-name" >JobZilla</span>
                   </div>
                    <p class="p-right-table-footer">Nền tảng tuyển dụng và tìm việc hàng đầu Việt Nam. Kết nối ứng viên tài năng với các cơ hội nghề nghiệp tuyệt vời.</p>
                    <div class="icon-right-table-footer">
                        <a href="#" class="social-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                            </svg>
                        </a>
                        <a href="#" class="social-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-twitter w-5 h-5"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
                        </a>
                        <a href="#" class="social-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin w-5 h-5"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                        </a>
                        <a href="#" class="social-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram w-5 h-5"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
                        </a>
                    </div>
                    
               </div>
                <div>
                    <h3 class="for-seeker">Dành cho ứng viên</h3>
                    <ul class="list-footer">
                        <li><a class="list-footer" href="">Tìm việc làm</a></li>
                        <li><a class="list-footer" href="">Công ty hàng đầu</a></li>
                        <li><a class="list-footer" href="">Cẩm nang nghề nghiệp</a></li>
                        <li><a class="list-footer" href="">Hồ sơ của tôi</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="for-seeker">Liên hệ</h3>
                    <ul class="list-footer">
                        <li>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail "><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                            <a class="list-footer" href="">contact@jobzilla.vn</a>
                        </li>
                        <li>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone "><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                            <a class="list-footer" href="">0369258147</a>
                        </li>
                        <li>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                            <a class="list-footer" href="">Tuy Hoà - Đắk Lắk</a>
                        </li>
                    </ul>
                </div>
           </div>
           <div class="copyright border-top">
                <p>© 2025 JobZilla. Tất cả quyền được bảo lưu.</p>
           </div>
        </div>
        
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
