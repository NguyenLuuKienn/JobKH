@{
    ViewData["Title"] = "Login Page";
}

<link href="~/css/login.css" rel="stylesheet" />
<main class="flex-1">
    <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center
                bg-gradient-to-br from-blue-50 to-slate-100
                py-8 px-4 md:py-12">

        <div class="w-full max-w-sm md:max-w-md">
            <div class="bg-white rounded-2xl shadow-xl p-6 md:p-8">

                <div class="flex justify-center mb-6 md:mb-8">
                    <div class="w-14 h-14 md:w-16 md:h-16 bg-blue-600 rounded-2xl flex items-center justify-center">
                        <svg class="w-7 h-7 md:w-8 md:h-8 text-white" ...></svg>
                    </div>
                </div>

                <h2 class="text-2xl md:text-3xl font-bold text-center text-gray-900 mb-2">
                    Đăng nhập
                </h2>

                <p class="text-center text-gray-600 mb-6 md:mb-8">
                    Chào mừng bạn trở lại với JobHub
                </p>

                <form class="space-y-5 md:space-y-6">

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1 md:mb-2">Email</label>
                        <input type="email" class="w-full px-3 py-3 md:px-4 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1 md:mb-2">Mật khẩu</label>
                        <input type="password" class="w-full px-3 py-3 md:px-4 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                    </div>

                    <button class="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700 transition">
                        Đăng nhập
                    </button>
                </form>

                <div class="mt-6 text-center">
                    <p class="text-sm text-gray-600">
                        Chưa có tài khoản?
                        <button class="text-blue-600 font-semibold">Đăng ký ngay</button>
                    </p>
                </div>

            </div>
        </div>
    </div>
</main>
